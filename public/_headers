# Cabeçalhos de segurança aplicados pelo Cloudflare Pages a todas as rotas.
# O marcador do host do Supabase (abaixo) é trocado no build pelo host de VITE_SUPABASE_URL (vite.config.ts),
# para cada ambiente (testes, produção) liberar o próprio projeto Supabase.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://__SUPABASE_HOST__; connect-src 'self' https://__SUPABASE_HOST__ wss://__SUPABASE_HOST__; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow

# O service worker precisa ser conferido a cada visita, senão uma versão antiga fica presa no aparelho.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
