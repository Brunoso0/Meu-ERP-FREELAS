# Segredos das Edge Functions. NÃO coloque valores aqui: cadastre no Supabase
# (Edge Functions > Secrets) ou com `supabase secrets set`. Cada ambiente tem os seus.
GEMINI_API_KEY=
GEMINI_MODEL=
RESEND_API_KEY=
RESEND_FROM=
