# Segredos das Edge Functions. No Supabase: Edge Functions → Secrets (ou
# `supabase secrets set --env-file`), um conjunto por ambiente (testes e
# produção). Localmente, copie para supabase/functions/.env.
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY o Supabase já injeta sozinho.

# find-leads: chave do Gemini (Google AI Studio) e, opcional, outro modelo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# reminders: e-mail dos lembretes pelo Resend (remetente num domínio verificado)
RESEND_API_KEY=
RESEND_FROM=Krono <lembretes@seu-dominio.com.br>

# webauthn: endereços onde o app roda, separados por vírgula
APP_ORIGINS=https://meus-freelas.pages.dev,http://localhost:5173
